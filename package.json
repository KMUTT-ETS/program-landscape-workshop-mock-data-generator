    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "pdfjs-dist": "^4.8.69",
    "tsx": "4.21.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-morph": "^24.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
