{
  "name": "program-landscape-workshop-mock-data-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Writes mock Program Landscape import spreadsheets for a university, consistent with its public TCAS round-3 numbers.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "workshop:mock": "tsx src/generate.ts",
    "sync-vendor": "tsx scripts/sync-vendor.ts",
